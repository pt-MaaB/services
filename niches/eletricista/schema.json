    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Têm eletricista disponível ao domingo em Coimbra?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. O serviço funciona 24 horas, 7 dias por semana, incluindo domingos e feriados. Para urgências elétricas — quadro disparado, sem luz, cheiro a queimado — contacte pelo WhatsApp ou telefone. Resposta em menos de 45 minutos."
          }
        },
        {
          "@type": "Question",
          "name": "O meu quadro elétrico continua a disparar — o que pode ser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Um disjuntor que dispara repetidamente indica sobrecarga (demasiados aparelhos no mesmo circuito), curto-circuito (fio danificado ou humidade) ou disjuntor defeituoso. Não tente resolver sem diagnóstico — a causa pode ser séria e representar risco de incêndio."
          }
        },
        {
          "@type": "Question",
          "name": "É cobrado orçamento ou visita?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O diagnóstico no local é apresentado antes de qualquer intervenção. Em deslocações nocturnas (após as 22h) ou ao fim de semana pode aplicar-se uma taxa de €25–€60. Confirme ao contactar."
          }
        },
        {
          "@type": "Question",
          "name": "Fazem certificação de instalações elétricas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Para instalações novas ou renovadas, emitimos a declaração de conformidade exigida pela DGEG. Este documento é necessário para activar contrato de energia, para seguros e para venda ou arrendamento do imóvel."
          }
        }
      ]
    }
