    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O orçamento tem algum custo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. A visita de avaliação e o orçamento são gratuitos. Só pagará o trabalho depois de aprovar o orçamento detalhado. Em urgências nocturnas (após as 22h) pode aplicar-se uma taxa de deslocação de €20–€50."
          }
        },
        {
          "@type": "Question",
          "name": "O trabalho tem garantia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Todo o trabalho executado tem garantia. Em caso de problema relacionado com a intervenção realizada, voltamos sem custo adicional. A duração da garantia varia conforme o tipo de trabalho."
          }
        },
        {
          "@type": "Question",
          "name": "Usam materiais de qualidade?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Utilizamos materiais certificados de marcas reconhecidas — tubagem em cobre ou multicamada, vedantes aprovados, acessórios com garantia de fabricante. O orçamento especifica sempre os materiais a utilizar."
          }
        },
        {
          "@type": "Question",
          "name": "Trabalham ao fim de semana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Para urgências, o serviço funciona 24 horas, 7 dias por semana, incluindo feriados. Para obras programadas, trabalhamos também ao sábado de manhã mediante agendamento prévio."
          }
        }
      ]
    }
